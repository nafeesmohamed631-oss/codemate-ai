DATABASE_URL=sqlite:///./codemate.db
JWT_SECRET=change-this-in-production
JWT_EXPIRE_MINUTES=43200
UPLOAD_DIR=./storage
MAX_FILE_MB=25

# Real-Time LLM Configuration
# Provider: auto, gemini, openai, custom
LLM_PROVIDER=auto

# For Google Gemini (Get free key from https://aistudio.google.com):
# LLM_API_KEY=AIzaSy...
# LLM_MODEL=gemini-2.5-flash

# For OpenAI ChatGPT (Get key from https://platform.openai.com):
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=

